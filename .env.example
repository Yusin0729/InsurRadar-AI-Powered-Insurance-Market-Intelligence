# ========================================================
# InsurRadar 環境變數配置範本
# 請將本檔案複製為 .env 並填入實際值（切勿將含金鑰之 .env 提交至 Git）
# ========================================================

# Google Gemini API 金鑰
GEMINI_API_KEY=your_gemini_api_key_here

# 使用之 Gemini 模型（新申請的免費金鑰已不能用 gemini-2.5-flash；2026-11 實測 gemini-3.5-flash-lite 可用）
GEMINI_MODEL=gemini-3.5-flash-lite

# ---- C 組真實資料與檢索（皆為選填）----
# 指定真實快照路徑（專案相對路徑）；留空＝預設 Mock 快照
# INSURRADAR_DATASET_PATH=data/real/dataset.json
# 設為 1 時不呼叫嵌入 API，只用關鍵字檢索（現場網路不穩時的備援）
# INSURRADAR_OFFLINE=1
# 向量嵌入模型（預設 gemini-embedding-001）
# GEMINI_EMBED_MODEL=gemini-embedding-001
# 設為 1 時，已快取的 Demo 題目直接用預先產生的回答、不呼叫 Gemini（快取由 python -m tools.build_demo_cache 產生）
# INSURRADAR_DEMO_CACHE=1
